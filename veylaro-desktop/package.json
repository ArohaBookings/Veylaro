{
  "name": "veylaro-code",
  "productName": "Veylaro Code",
  "private": true,
  "version": "1.0.0",
  "description": "Veylaro Code \u2014 a local AI coding environment with Laro Lite, Med and Max.",
  "author": "Veylaro Labs",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "app": "electron .",
    "dist": "vite build && electron-builder --mac --publish never",
    "dist:mac": "vite build && electron-builder --mac zip --publish never",
    "dist:win": "vite build && electron-builder --win --publish never",
    "dist:all": "vite build && electron-builder --mac zip --win --publish never",
    "cli": "node cli/veylaro.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "ai.veylaro.code",
    "productName": "Veylaro Code",
    "artifactName": "VeylaroCode-${version}-${arch}-${os}.${ext}",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "cli",
        "to": "cli"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "build/afterPack.cjs",
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "VeylaroCode-Setup-${version}.${ext}",
      "shortcutName": "Veylaro Code"
    },
    "portable": {
      "artifactName": "VeylaroCode-${version}-win-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "bin": {
    "veylaro": "cli/veylaro.cjs"
  }
}
